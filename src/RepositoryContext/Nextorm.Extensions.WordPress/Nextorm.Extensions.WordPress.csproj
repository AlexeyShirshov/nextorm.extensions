<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <PackageVersion>1.0.1</PackageVersion>
    <PackageId>Nextorm.Extensions.WordPress</PackageId>
    <IsPackable>true</IsPackable>
    <RepositoryUrl>https://github.com/AlexeyShirshov/nextorm.extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>nextorm;wordpress;mysql;mariadb</PackageTags>
    <Description>Nextorm repository context for the WordPress terms schema.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nextorm.MySql" Version="1.0.11" />
    <PackageReference Include="Nextorm.MariaDb" Version="1.0.11" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
