<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Nextorm.Extensions.OpenCode</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Nextorm repository context for the OpenCode SQLite database schema.</Description>
    <RepositoryUrl>https://github.com/AlexeyShirshov/nextorm.extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>nextorm;opencode;sqlite</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nextorm.Sqlite" Version="1.0.11" />
  </ItemGroup>
</Project>
