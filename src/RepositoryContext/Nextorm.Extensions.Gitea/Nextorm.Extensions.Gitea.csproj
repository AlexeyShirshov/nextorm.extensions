<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageId>Nextorm.Extensions.Gitea</PackageId>
    <IsPackable>true</IsPackable>
    <RepositoryUrl>https://github.com/AlexeyShirshov/nextorm.extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>nextorm;gitea;sqlite</PackageTags>
    <Description>Nextorm repository context for the Gitea 1.24.7 SQLite schema.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nextorm.Sqlite" Version="1.0.11" />
  </ItemGroup>
</Project>
